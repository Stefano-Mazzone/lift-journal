{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lift-journal",
  "main": "src/index.js",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "COACH_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 4,
        "period": 60
      }
    },
    {
      "name": "FEEDBACK_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 2,
        "period": 60
      }
    }
  ],
  "previews": {
    "ai": {
      "binding": "AI"
    }
  }
}
